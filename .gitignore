node_modules/
dist/
dev-dist/
# Vite's dependency pre-bundling cache. It lands here rather than in
# node_modules/.vite because the workspace has none of its own.
.vite/
*.tsbuildinfo
.DS_Store
# The database the container writes, bind-mounted from here. The contents are
# ignored; the directory is tracked, so Docker never has to create it as root.
data/*
!data/.gitkeep
.env

# Playwright MCP scratch output
.playwright-mcp/
*.db
*.db-wal
*.db-shm

# The deploy script takes this so a timer run and a manual run cannot overlap.
.deploy.lock
# And this remembers a commit that failed, so a bad push is not rebuilt on loop.
.deploy-failed
