# Copy to .env. The same value goes on each device under Settings → Sync.
# Generate one with:  openssl rand -base64 24
CALCFLOW_TOKEN=

# Only needed if the app is ever served from somewhere other than this server —
# a comma-separated list of origins. Empty means "reflect whoever asks", which
# is fine behind Tailscale.
CALCFLOW_ORIGINS=

LOG_LEVEL=info
